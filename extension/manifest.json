{
  "manifest_version": 3,
  "name": "Local Chat Translator",
  "version": "0.1.0",
  "description": "Translate individual Google Chat messages locally in Chrome, with the original text preserved.",
  "permissions": ["storage"],
  "action": { "default_title": "Local Chat Translator", "default_popup": "settings.html" },
  "options_ui": { "page": "settings.html", "open_in_tab": true },
  "content_scripts": [{
    "matches": ["https://chat.google.com/*", "https://mail.google.com/mail/*"],
    "js": ["content.js"],
    "all_frames": true,
    "run_at": "document_idle"
  }],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  }
}
